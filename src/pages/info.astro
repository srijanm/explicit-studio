---
import BaseLayout from '../layouts/BaseLayout.astro';

// Flip to false when we stop actively recruiting — that removes the hiring
// note below the founder's signature and nothing else.
const hiring = true;

// The note, kept as data so the paragraph rhythm stays obvious and editable.
// Short lines are deliberate; don't merge them into longer paragraphs.
const note = [
  "I'm pretty optimistic about the future that technology and creativity can create together.",
  "Which is apparently becoming a contrarian position, especially with all the (p)doom around AI coming for creative jobs.",
  "I think the opposite is true.",
  "Technology pushes creativity forward. Creativity pushes technology forward.",
  "It took an enormous amount of creativity to build the iPhone. In turn, it gave millions of people a completely new way to express themselves through photography.",
  "The cycle keeps going. The more powerful our tools become, the more we can imagine. And the more ambitious our imagination becomes, the more technology we build.",
  "I also think technology products are becoming some of the most important cultural products of our time. They shape how we work, communicate, create, date, spend money and understand the world.",
  "Which makes it particularly strange that so much of the creative work around technology has become incredibly boring.",
  "Everything looks the same. Everyone sounds the same. Creative risk seems to be disappearing at exactly the moment our creative possibilities are expanding.",
  "And with AI making pretty-good work easier than ever, I think genuinely great ideas are going to become more valuable, not less.",
  "I've spent much of my career moving between these worlds — music, advertising, film and building companies of my own.",
  "One thing I've learned is that making something valuable is only half the problem. You also have to help people understand why it matters.",
  "That's why I'm building Explicit.",
  "I want us to understand technology deeply, take creativity seriously, and help important ideas find their place in culture.",
  "Over the next five years, if we can inspire more creativity, make technology a little less boring, bring some joy to people and make good money for our clients and ourselves, I think we'll have done our job pretty well."
];
---

<BaseLayout
  title="About — Explicit"
  description="Explicit is a strategic creative company for technology, working with companies when something important changes."
  hideCta={true}
>

  <!-- A short introduction -->
  <section class="about-intro reveal">
    <h1 class="about-intro__headline">A strategic creative company for technology.</h1>
    <p class="about-intro__body">
      Explicit works with technology companies when something important changes. We get close to
      the product, business and people involved, then figure out how to make that change meaningful
      in the market. The work can take many forms, but it always starts with understanding what
      matters.
    </p>
  </section>

  <!-- A note from the founder -->
  <section class="note reveal">
    <div class="note__grid">
      <div class="note__body">
        <h2 class="note__heading">A note from the founder</h2>
        {note.map((p) => <p>{p}</p>)}

        <div class="note__sign">
          <span class="note__name">Srijan</span>
          <span class="note__role">Founder, Explicit</span>
        </div>

        {hiring && (
          <aside class="hiring">
            <h3 class="hiring__heading">Come make technology less boring.</h3>
            <p>
              I'm building a small, curious team that likes understanding hard problems, coming up
              with ambitious ideas and taking creative risks.
            </p>
            <p>Come do some of the most interesting work of your career.</p>
            <a
              href="mailto:hey@explicit.studio?subject=I%20want%20to%20work%20with%20Explicit"
              class="hiring__link"
            >
              Join Explicit <span class="arrow">&rarr;</span>
            </a>
          </aside>
        )}
      </div>

      <div class="note__portrait">
        <img src="/images/srijan-portrait.JPG" alt="Srijan Mahajan" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===== Introduction ===== */
  .about-intro {
    padding: 40px var(--section-padding-x) clamp(48px, 6vw, 72px);
  }

  .about-intro__headline {
    font-size: var(--text-h1);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.03em;
    max-width: 20ch;
    margin-bottom: 28px;
  }

  .about-intro__body {
    font-size: var(--text-h3);
    font-weight: 400;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 68ch;
  }

  /* ===== Founder's note ===== */
  .note {
    padding: 0 var(--section-padding-x) clamp(56px, 7vw, 88px);
    border-top: 1px solid var(--color-rule);
    padding-top: clamp(48px, 6vw, 72px);
  }

  .note__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(40px, 6vw, 72px);
    align-items: start;
  }

  .note__heading {
    font-size: var(--text-h2);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
  }

  /* A letter, not a manifesto — one readable column, the writing does the work. */
  .note__body p {
    font-size: var(--text-h3);
    font-weight: 400;
    line-height: 1.7;
    color: var(--color-text);
    max-width: 58ch;
    margin-bottom: 1.15em;
  }

  .note__sign {
    margin-top: 36px;
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
  }

  .note__name {
    font-size: var(--text-h3);
    font-weight: 500;
    color: var(--color-text);
  }

  .note__role {
    font-size: var(--text-small);
    font-weight: 400;
    color: var(--color-text-tertiary);
  }

  .note__portrait {
    position: sticky;
    top: 40px;
  }

  .note__portrait img {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  /* ===== Hiring note — a quiet invitation under the signature ===== */
  .hiring {
    margin-top: clamp(40px, 5vw, 56px);
    padding-top: clamp(24px, 3vw, 32px);
    border-top: 1px solid var(--color-rule);
    max-width: 58ch;
  }

  .hiring__heading {
    font-size: var(--text-h3);
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 14px;
  }

  .hiring p {
    font-size: var(--text-small);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 0.9em;
  }

  .hiring__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-accent);
    transition: color 0.3s ease;
  }

  .hiring__link:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 900px) {
    .note__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .note__portrait {
      position: static;
      order: -1;
      max-width: 320px;
    }
  }

  @media (max-width: 767px) {
    .about-intro__headline {
      max-width: none;
    }

    .note__body p {
      max-width: none;
    }
  }
</style>
