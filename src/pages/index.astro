---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';

const workProjects = projects.filter((p) => p.category === 'work');
const explorations = projects.filter((p) => p.category === 'exploration');

// Client logos, laid out as two centred rows. `h` is a per-logo height so each
// mark reads at the same optical weight — a single shared height makes the
// heavy slab marks (EDT) shout and the delicate ones (Piano Man) vanish.
const clientLogos = [
  { src: '/images/logos/desicrew.png', alt: 'DesiCrew', h: 30 },
  { src: '/images/logos/pause.png', alt: 'Pause', h: 30 },
  { src: '/images/logos/QAonC.svg', alt: 'QAonCloud', h: 32 },
  { src: '/images/logos/agentq.png', alt: 'AgentQ', h: 26 },
  { src: '/images/logos/originone.png', alt: 'Origin One', h: 34 },
  { src: '/images/logos/attis.png', alt: 'Attis', h: 30 },
  { src: '/images/logos/pianoman.png', alt: 'Piano Man', h: 36 },
  { src: '/images/logos/edt.png', alt: 'EDT', h: 24 }
];
const logoRows = [clientLogos.slice(0, 4), clientLogos.slice(4)];

const testimonials = [
  {
    quote: "Srijan didn't just give us a brand, he gave us a story that tied our business, product & distribution in a way that would've been impossible to do otherwise.",
    name: "Sushine Ullas",
    role: "Chief Business Officer, QAonCloud",
    avatar: "/images/avatars/placeholder-1.svg",
    cardBg: "transparent",
    textColor: "#F5F5F5"
  },
  {
    quote: "Srijan has been an integral resource for the past 6 months, bringing founder energy to our GTM motion. He moves fast, understands business goals & is an excellent partner to have on your side.",
    name: "Pradeep Aiyyagiri",
    role: "Co-Founder Qwikbuild, Ex-CPO, Slice",
    avatar: "/images/avatars/pradeep.jpeg",
    cardBg: "transparent",
    textColor: "#F5F5F5"
  },
  {
    quote: "Srijan is highly perceptive & insightful. His deconstruction of where we stand and want to get to is tremendously educational, and he sets the cogs in motion to achieve it. Results came shockingly fast. A pleasure to work with.",
    name: "Pushkar Thakur",
    role: "Founder, Origin One & The Grafiosi",
    avatar: "/images/avatars/pushkar.jpeg",
    cardBg: "transparent",
    textColor: "#F5F5F5"
  }
];
---

<BaseLayout title="Explicit Studio — Creative Partners for Startups">

  <!-- Hero -->
  <section class="hero">
    <h1 class="hero__headline">
      Turn your product into a brand that gets attention and makes money.
    </h1>
    <p class="hero__descriptor">Creative partners to Startups & VCs. Working across Growth, Storytelling & New Media.</p>
    <div class="hero__media">
      <video src="/images/projects/home-showreel-thumb.mp4" autoplay muted loop playsinline></video>
    </div>
  </section>

  <!-- Logo Bar -->
  <section class="logos-section">
    <p class="logos-section__text">
      Working with ambitious founders & adventure capitalists across consumer & enterprise tech, AI & D2C.
    </p>
    <div class="logos-grid">
      {logoRows.map(row => (
        <div class="logos-row">
          {row.map(logo => (
            <img src={logo.src} alt={logo.alt} class="client-logo" style={`--logo-h: ${logo.h}px;`} />
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-section reveal">
    <div class="testimonials-grid">
      {testimonials.map(t => (
        <div class="testimonial-card">
          <p class="testimonial-card__quote" style={`color: ${t.textColor};`}>"{t.quote}"</p>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar">
              {t.avatar ? (
                <img src={t.avatar} alt={t.name} />
              ) : (
                <span>{t.name.charAt(0)}</span>
              )}
            </div>
            <div class="testimonial-card__info">
              <span class="testimonial-card__name" style={`color: ${t.textColor};`}>{t.name}</span>
              <span class="testimonial-card__role" style={`color: rgba(255,255,255,0.5);`}>{t.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- The Pitch -->
  <section class="problem-section reveal">
    <div class="problem-section__inner">
      <p class="problem-section__opening">
        Creativity has been my business for 15 years.
      </p>
      <div class="problem-section__body">
        <p>I've made money from it as a musician, in advertising, in film, and by building two startups of my own.<br /><br />I'm not a strategist who's never shipped anything, but a founder who spent his own money, and learned what actually works.<br /><br />I help startups with brand strategy, positioning, advertising & content to get your story out in the most honest, explicit way possible.</p>
        <p>If you believe creativity is a business advantage and want a creative partner who gets that, we should talk.</p>
      </div>
    </div>
  </section>

  <!-- CTA after pitch -->
  <section class="pitch-cta reveal">
    <a href="/contact" class="btn-primary pitch-cta__button">
      Get in touch <span class="arrow">&rarr;</span>
    </a>
  </section>

  <!-- Selected Work -->
  <section class="work-section reveal">
    <h2 class="work-section__title">We make things people want. We make people want things.</h2>
    <div class="home-work-grid">
      {workProjects.map((project) => (
        <ProjectCard project={project} useHomeThumbnail={true} />
      ))}
    </div>
    {explorations.length > 0 && (
      <h3 class="work-section__subtitle">Explorations</h3>
      <div class="home-work-grid">
        {explorations.map((project) => (
          <ProjectCard project={project} useHomeThumbnail={true} />
        ))}
      </div>
    )}
  </section>

</BaseLayout>

<style>
  /* ===== Hero ===== */
  .hero {
    padding: 40px var(--section-padding-x) 40px;
  }

  .hero__descriptor {
    font-size: var(--text-h3);
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: 20px;
  }

  .hero__headline {
    font-size: var(--text-hero);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    max-width: none;
    margin-bottom: 12px;
  }

  .hero__media {
    width: 100%;
    margin-top: 40px;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .hero__media video {
    width: 100%;
    display: block;
  }

  /* ===== Logo Bar ===== */
  .logos-section {
    padding: 24px var(--section-padding-x) 24px;
  }

  .logos-section__text {
    font-size: var(--text-h3);
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 24px;
  }

  .logos-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
    width: 100%;
  }

  .logos-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 28px clamp(48px, 7vw, 100px);
  }

  .client-logo {
    height: var(--logo-h, 32px);
    width: auto;
  }

  /* ===== Selected Work ===== */
  .work-section {
    padding: 60px var(--section-padding-x) clamp(40px, 5vw, 60px);
  }

  .work-section__title {
    font-size: var(--text-h2);
    font-weight: 500;
    margin-bottom: 48px;
  }

  .home-work-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 4vw, 40px);
  }

  .work-section__subtitle {
    font-size: var(--text-h2);
    font-weight: 500;
    margin-top: 60px;
    margin-bottom: 48px;
  }

  .view-all-card {
    display: block;
    width: 100%;
    background-color: var(--color-accent);
    border-radius: var(--radius-md);
    padding: clamp(11px, 1.4vw, 20px);
    text-decoration: none;
    color: #FFFFFF;
    text-align: right;
    margin-top: clamp(24px, 3vw, 40px);
  }

  .view-all-card__text {
    font-size: var(--text-h3);
    font-weight: 500;
  }

  /* ===== The Problem ===== */
  .problem-section {
    padding: clamp(40px, 5vw, 60px) var(--section-padding-x);
    background: var(--color-bg);
  }

  .problem-section__inner {
    max-width: 800px;
  }

  .problem-section__opening {
    font-size: var(--text-h2);
    font-weight: 500;
    font-style: normal;
    line-height: 1.3;
    margin-bottom: 32px;
  }

  .problem-section__body p {
    font-size: var(--text-h3);
    font-weight: 400;
    line-height: 1.6;
    margin-bottom: 24px;
    color: var(--color-text);
  }

  .problem-section__body p:last-child {
    margin-bottom: 0;
  }

  .problem-section__body strong {
    font-weight: 700;
  }

  /* ===== Testimonials ===== */
  .testimonials-section {
    padding: clamp(40px, 5vw, 60px) var(--section-padding-x);
    background: var(--color-bg);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2vw, 24px);
  }

  .testimonial-card {
    border-radius: var(--radius-md);
    padding: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 280px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .testimonial-card__quote {
    font-size: var(--text-body);
    font-weight: 400;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .testimonial-card__author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .testimonial-card__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .testimonial-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial-card__avatar span {
    font-size: 1rem;
    font-weight: 500;
  }

  .testimonial-card__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonial-card__name {
    font-size: var(--text-small);
    font-weight: 500;
  }

  .testimonial-card__role {
    font-size: var(--text-tiny);
    font-weight: 400;
  }

  /* ===== Pitch CTA ===== */
  .pitch-cta {
    padding: 0 var(--section-padding-x) clamp(40px, 5vw, 60px);
    background: var(--color-bg);
  }

  .pitch-cta__button {
    display: inline-flex;
  }

  /* ===== Responsive ===== */
  @media (max-width: 767px) {
    .hero {
      padding: 32px var(--section-padding-x) 32px;
    }

    .hero__headline {
      margin-bottom: 8px;
    }

    .hero__media {
      margin-top: 32px;
    }

    .logos-section {
      padding: 32px var(--section-padding-x) 32px;
      margin-bottom: 16px;
    }

    .logos-grid {
      gap: 24px;
    }

    .logos-row {
      gap: 24px 32px;
    }

    .testimonials-section {
      padding-top: 16px;
    }

    .testimonials-grid {
      grid-template-columns: 1fr;
    }

    .client-logo {
      height: calc(var(--logo-h, 32px) * 0.82);
    }

  }
</style>
