---
const pageTitle = "in good co — signature tune | moodboard";

const directions = [
  {
    num: "01",
    title: "Big Band",
    concept: [
      "Traditional big band — brass, walking bass, drums",
      "Indian melody as the lead line, carried on sax / muted trumpet / electric guitar",
      "Instrumental throughout",
    ],
    refs: [
      { artist: "Frank Sinatra", track: "The Coffee Song", id: "zTbJBnkRkFo" },
      { artist: "Stacey Kent", track: "Breakfast On The Morning Tram", id: "DJyuPzHfMP8" },
    ],
    refsLabel: "References — mood",
    pros: [
      "High energy and feels very international, especially for video content",
      "Sophisticated, classic “international café”",
      "Highly versatile across film tones",
      "Strong hummable hook potential",
    ],
    cons: [
      "Global café audio already lives here (Starbucks etc) — risk of feeling familiar before it lands as ours",
    ],
  },
  {
    num: "02",
    title: "Lo-Fi",
    concept: [
      "Downtempo lo-fi bed — vinyl crackle, soft drum machine, Rhodes, sub bass",
      "Indian melody carried on a Western instrument (Rhodes / electric guitar / muted synth)",
      "Instrumental",
    ],
    refs: [
      { artist: "Nujabes", track: "Force of Nature", id: "YeS3PDfUeqM" },
      { artist: "LofiGirl", track: "Lofi Hip Hop Radio (Genre Archetype)", id: "jfKfPfyJRdk" },
    ],
    refsLabel: "References — mood",
    pros: [
      "Effortlessly contemporary, reel-native",
      "Lowest first-listen barrier for the target audience",
    ],
    cons: [
      "One emotional speed — doesn't scale to launch moments or high-energy films",
      "Can get lost in the noise — lo-fi is everywhere right now, not distinctive enough to own",
    ],
  },
  {
    num: "03",
    title: "Found Sound + Konokol",
    concept: [
      "Built from real sounds — coffee grinder, espresso machine, cup on saucer, café ambience",
      "Sampled, tuned, arranged into a beat",
      "Konokol as the principal voice",
      "Melodic phrases emerge from the konokol patterns",
    ],
    note: "Konokol is the South Indian vocal system for speaking rhythm — using syllables like 'ta ka di mi' to recite complex percussion patterns. It's the human voice as a rhythm instrument.",
    refs: [
      { artist: "Diego Stocco", track: "Music from a Dry Cleaner", id: "FCLqfiSKGKE" },
      { artist: "Matthew Herbert", track: "An Empire of Coffee", id: "XJ_6vMeCf0M" },
      { artist: "Matthew Herbert", track: "These Branded Waters", id: "_dpdVP3eMLk" },
      { artist: "Matthew Herbert", track: "The Truncated Life of a Modern Industrial Chicken", id: "y4Afl__7M7w" },
    ],
    refsLabel: "References — mood",
    pros: [
      "Wildly distinctive — no café brand globally has touched this",
      "Strongest brand story of the four",
      "Owns konokol as a sonic signature",
    ],
    cons: [
      "Most experimental — first listen may confuse before it converts",
      "May not deliver a clear, hummable melodic identifier — the signature is rhythmic and textural, not melodic",
    ],
  },
  {
    num: "04",
    title: "Modern Indian Electronic",
    concept: [
      "Modern global production — analog synths, programmed beats, real-room acoustic elements",
      "Indian melody on Western instruments (synth lead, Rhodes, electric guitar)",
      "Instrumental",
    ],
    refs: [
      { artist: "Anoushka Shankar", track: "Daybreak (Chapter III, 2025)", id: "x7E7sg7fB04" },
      { artist: "OAFF, Savera", track: "Doobey (Gehraiyaan)", id: "6eGCi4SVy94" },
      { artist: "Ritviz", track: "Liggi", id: "6BYIKEH0RCQ" },
      { artist: "Sarathy Korwar", track: "Bol (More Arriving)", id: "7WppAg6juAw" },
    ],
    refsLabel: "References — production sensibility",
    pros: [
      "Scales across every brand asset speed — reels, films, launches, hype cuts",
      "Closest to what the 25–40 audience already considers “modern Indian”",
      "Confident, contemporary, internationally legible",
    ],
    cons: [
      "Risk of dating faster than the others — current sound rather than timeless",
    ],
  },
];

const quickRead = [
  { name: "Big Band", distinctive: "Med", versatile: "High", risk: "Familiar (Starbucks-adjacent)" },
  { name: "Lo-Fi", distinctive: "Low", versatile: "Med", risk: "One emotional speed + gets lost in the noise" },
  { name: "Found Sound + Konokol", distinctive: "Very High", versatile: "Med", risk: "Experimental first-listen" },
  { name: "Modern Indian Electronic", distinctive: "Med-High", versatile: "Very High", risk: "Dates faster" },
];

const pillClass = (v: string) => {
  if (v === "Low") return "pill pill--low";
  if (v === "Med") return "pill pill--med";
  return "pill pill--high";
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/ingoodco">
        <img src="/ingoodco/logo.jpg" alt="in good co" class="brand__logo" />
        <span class="brand__text">in good co — signature tune | moodboard</span>
      </a>
      <span class="version">Moodboard · v01</span>
    </header>

    <main class="page">
      <h1 class="doc-title">in good co — signature tune | moodboard</h1>

      <section class="brief">
        <span class="kicker">The brief</span>
        <ul class="bullets">
          <li>45–60s piece + 10s identifier</li>
          <li>Lives on brand films &amp; social content</li>
          <li>Contemporary, warm, aspirational, distinctly Indian — never caricatured</li>
        </ul>
      </section>

      <section class="position">
        <span class="kicker kicker--on-blue">Our position on the Indian-ness</span>
        <h2 class="position__headline">
          The Indian-ness lives in the melody, not the instruments.
        </h2>
        <ul class="bullets bullets--on-blue">
          <li>It lives in the melody — raga and modal phrasing — not the instruments themselves.</li>
          <li>No sitar, sarangi, bansuri, tabla, dholak, or vocals. That's where cliche and appropriation live.</li>
          <li>Konokol is the one exception — it's a rhythmic system, not an "Indian sound" per se.</li>
          <li>Everything else stays global and contemporary in instrumentation.</li>
        </ul>
        <p class="position__callout">
          What we need to lock right now: the soundscape + the genre/vibe. Not the melody or specifics.
        </p>
      </section>

      {directions.map((d) => (
        <section class="direction">
          <div class="direction__head">
            <div class="direction__meta">
              <span class="numeral">{d.num}</span>
              <span class="kicker">Direction</span>
            </div>
            <div class="direction__body">
              <h2 class="direction__title">{d.title}</h2>
              <ul class="bullets">
                {d.concept.map((c) => <li>{c}</li>)}
              </ul>
              {d.note && <p class="direction__note">{d.note}</p>}
            </div>
          </div>

          <div class="refs">
            <span class="kicker">{d.refsLabel}</span>
            <div class={`refs__grid refs__grid--${d.refs.length}`}>
              {d.refs.map((r) => (
                <figure class="ref">
                  <button
                    type="button"
                    class="yt-lite"
                    data-id={r.id}
                    aria-label={`Play ${r.artist} — ${r.track}`}
                  >
                    <img
                      src={`https://img.youtube.com/vi/${r.id}/hqdefault.jpg`}
                      alt=""
                      loading="lazy"
                      class="yt-lite__thumb"
                    />
                    <span class="yt-lite__play" aria-hidden="true">
                      <svg viewBox="0 0 68 48" width="56" height="40">
                        <path
                          d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74 0 13.05 0 24 0 24s0 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C68 34.95 68 24 68 24s0-10.95-1.48-16.26z"
                          fill="#98AED6"
                        />
                        <path d="M45 24 27 14v20" fill="#FAFAF7" />
                      </svg>
                    </span>
                  </button>
                  <figcaption class="ref__caption">
                    <span class="ref__artist">{r.artist}</span>
                    <span class="ref__track">{r.track}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>

          <div class="pc">
            <div class="pc__col">
              <span class="kicker">Pros</span>
              <ul class="bullets bullets--pros">
                {d.pros.map((p) => <li>{p}</li>)}
              </ul>
            </div>
            <div class="pc__col">
              <span class="kicker">Cons</span>
              <ul class="bullets bullets--cons">
                {d.cons.map((c) => <li>{c}</li>)}
              </ul>
            </div>
          </div>
        </section>
      ))}

      <section class="quickread">
        <h2 class="quickread__heading">Quick read</h2>
        <div class="quickread__tablewrap">
          <table class="quickread__table">
            <thead>
              <tr>
                <th>Direction</th>
                <th>Distinctive</th>
                <th>Versatile</th>
                <th>Main risk</th>
              </tr>
            </thead>
            <tbody>
              {quickRead.map((r) => (
                <tr>
                  <td>{r.name}</td>
                  <td><span class={pillClass(r.distinctive)}>{r.distinctive}</span></td>
                  <td><span class={pillClass(r.versatile)}>{r.versatile}</span></td>
                  <td class="quickread__risk">{r.risk}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__left">
        <span class="kicker">Prepared by</span>
        <a href="https://www.explicit.studio/" target="_blank" rel="noopener noreferrer">
          <img src="/images/logos/logo.png" alt="Explicit Studio" class="site-footer__logo" />
        </a>
      </div>
      <span class="version">in good co · Signature tune · Moodboard v01</span>
    </footer>

    <script is:inline>
      document.addEventListener("click", (e) => {
        const btn = e.target.closest(".yt-lite");
        if (!btn) return;
        const id = btn.dataset.id;
        if (!id) return;
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = btn.getAttribute("aria-label") || "YouTube video";
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
        iframe.allowFullscreen = true;
        iframe.loading = "lazy";
        iframe.className = "yt-lite__iframe";
        btn.replaceWith(iframe);
      });
    </script>

    <style is:global>
      @font-face {
        font-family: 'PP Neue Montreal';
        src: url('/fonts/PPNeueMontreal-Regular.ttf') format('truetype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'PP Neue Montreal';
        src: url('/fonts/PPNeueMontreal-Medium.ttf') format('truetype');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'PP Neue Montreal';
        src: url('/fonts/PPNeueMontreal-Bold.ttf') format('truetype');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --bg: #FAFAF7;
        --ink: #1A1A1A;
        --ink-soft: #4A4A4A;
        --muted: #8A8A85;
        --rule: #E6E4DC;
        --blue: #98AED6;
        --blue-tint: #E6ECF5;
        --blue-deep: #6F8AB8;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "PP Neue Montreal", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-weight: 500;
        font-size: 16px;
        line-height: 1.55;
        letter-spacing: -0.02em;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a { color: inherit; }

      img { display: block; max-width: 100%; }

      /* ───── Header ───── */
      .site-header {
        max-width: 1100px;
        margin: 0 auto;
        padding: 32px 40px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        color: var(--ink);
      }
      .brand__logo {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 2px;
        flex-shrink: 0;
      }
      .brand__text {
        font-size: 14px;
        font-weight: 500;
        letter-spacing: -0.01em;
        color: var(--ink-soft);
      }
      .version {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* ───── Page shell ───── */
      .page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 40px 80px;
      }

      .doc-title {
        font-size: 36px;
        font-weight: 500;
        letter-spacing: -0.04em;
        line-height: 1.1;
        margin: 0 0 56px;
        max-width: 720px;
      }

      .kicker {
        display: inline-block;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .kicker--on-blue { color: var(--blue-deep); }

      /* ───── Bullets ───── */
      .bullets {
        list-style: none;
        padding: 0;
        margin: 16px 0 0;
      }
      .bullets li {
        font-size: 17px;
        font-weight: 500;
        line-height: 1.55;
        padding-left: 18px;
        position: relative;
        margin-bottom: 8px;
        color: var(--ink);
      }
      .bullets li::before {
        content: "·";
        position: absolute;
        left: 4px;
        top: -2px;
        font-size: 22px;
        color: var(--blue-deep);
        line-height: 1;
      }
      .bullets--on-blue li { color: var(--ink); }
      .bullets--on-blue li::before { color: #fff; }

      .bullets--pros li::before { content: "+"; font-size: 16px; top: 0; color: var(--blue-deep); }
      .bullets--cons li::before { content: "−"; font-size: 16px; top: 0; color: var(--muted); }

      /* ───── Brief ───── */
      .brief {
        padding: 32px 0 48px;
        border-top: 1px solid var(--rule);
      }

      /* ───── Position panel ───── */
      .position {
        background: var(--blue);
        padding: 48px 48px 44px;
        margin: 8px 0 64px;
        border-radius: 4px;
      }
      .position__headline {
        font-size: 40px;
        font-weight: 500;
        letter-spacing: -0.04em;
        line-height: 1.05;
        margin: 14px 0 24px;
        max-width: 820px;
        color: var(--ink);
      }
      .position__callout {
        margin: 28px 0 0;
        padding: 16px 20px;
        background: rgba(255,255,255,0.55);
        border-radius: 3px;
        font-size: 15px;
        font-weight: 500;
        color: var(--ink);
        max-width: 760px;
      }

      /* ───── Direction blocks ───── */
      .direction {
        padding: 56px 0;
        border-top: 1px solid var(--rule);
      }
      .direction__head {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 48px;
        margin-bottom: 40px;
      }
      .direction__meta { display: flex; flex-direction: column; gap: 8px; }
      .numeral {
        font-size: 68px;
        font-weight: 500;
        letter-spacing: -0.04em;
        line-height: 1;
        color: var(--blue);
      }
      .direction__title {
        font-size: 44px;
        font-weight: 500;
        letter-spacing: -0.04em;
        line-height: 1.05;
        margin: 0;
      }
      .direction__note {
        margin: 18px 0 0;
        font-size: 14px;
        font-style: italic;
        font-weight: 400;
        line-height: 1.55;
        color: var(--muted);
        max-width: 640px;
      }

      /* ───── References ───── */
      .refs {
        margin: 8px 0 40px;
        padding-left: 248px;
      }
      .refs__grid {
        display: grid;
        gap: 20px;
        margin-top: 16px;
      }
      .refs__grid--2 { grid-template-columns: repeat(2, 1fr); }
      .refs__grid--4 { grid-template-columns: repeat(4, 1fr); }

      .ref { margin: 0; }
      .ref__caption {
        margin-top: 12px;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .ref__artist {
        font-size: 14px;
        font-weight: 500;
        letter-spacing: -0.01em;
        color: var(--ink);
      }
      .ref__track {
        font-size: 13px;
        font-weight: 500;
        color: var(--ink-soft);
        letter-spacing: -0.01em;
      }

      /* ───── YouTube lite ───── */
      .yt-lite {
        position: relative;
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        padding: 0;
        border: 1px solid var(--rule);
        background: #000;
        cursor: pointer;
        overflow: hidden;
        border-radius: 3px;
        transition: border-color 160ms ease, transform 160ms ease;
      }
      .yt-lite:hover { border-color: var(--blue); transform: translateY(-1px); }
      .yt-lite__thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .yt-lite__play {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
      }
      .yt-lite__play svg { filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3)); }
      .yt-lite__iframe {
        width: 100%;
        aspect-ratio: 16 / 9;
        border: 1px solid var(--rule);
        border-radius: 3px;
        background: #000;
      }

      /* ───── Pros / Cons ───── */
      .pc {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        padding-left: 248px;
      }

      /* ───── Quick read ───── */
      .quickread {
        margin-top: 40px;
        padding-top: 56px;
        border-top: 1px solid var(--rule);
      }
      .quickread__heading {
        font-size: 28px;
        font-weight: 500;
        letter-spacing: -0.04em;
        margin: 0 0 24px;
      }
      .quickread__tablewrap { overflow-x: auto; }
      .quickread__table {
        width: 100%;
        border-collapse: collapse;
        font-size: 15px;
      }
      .quickread__table th,
      .quickread__table td {
        text-align: left;
        padding: 14px 16px;
        border-bottom: 1px solid var(--rule);
        vertical-align: middle;
      }
      .quickread__table th {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        border-bottom: 1px solid var(--ink);
      }
      .quickread__table td:first-child { font-weight: 500; }
      .quickread__risk { color: var(--ink-soft); }

      .pill {
        display: inline-block;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0;
        border-radius: 999px;
        line-height: 1.2;
      }
      .pill--low { background: #ECEAE2; color: var(--muted); }
      .pill--med { background: var(--blue-tint); color: var(--blue-deep); }
      .pill--high { background: var(--blue); color: var(--ink); }

      /* ───── Footer ───── */
      .site-footer {
        max-width: 1100px;
        margin: 40px auto 0;
        padding: 32px 40px 48px;
        border-top: 1px solid var(--rule);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
      }
      .site-footer__left {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .site-footer__logo {
        height: 22px;
        width: auto;
        opacity: 0.85;
        transition: opacity 160ms ease;
      }
      .site-footer__logo:hover { opacity: 1; }

      /* ───── Responsive ───── */
      @media (max-width: 880px) {
        .site-header { padding: 24px 24px 16px; }
        .page { padding: 24px 24px 64px; }
        .doc-title { font-size: 28px; margin-bottom: 40px; }

        .position { padding: 32px 24px 28px; }
        .position__headline { font-size: 28px; }

        .direction { padding: 40px 0; }
        .direction__head { grid-template-columns: 1fr; gap: 16px; margin-bottom: 32px; }
        .direction__meta { flex-direction: row; align-items: baseline; gap: 14px; }
        .numeral { font-size: 48px; }
        .direction__title { font-size: 32px; }

        .refs, .pc { padding-left: 0; }
        .refs__grid--2, .refs__grid--4 { grid-template-columns: 1fr; }
        .pc { grid-template-columns: 1fr; gap: 24px; }

        .quickread__heading { font-size: 22px; }
        .quickread__table th,
        .quickread__table td { padding: 12px 10px; font-size: 13px; }

        .site-footer { flex-direction: column; align-items: flex-start; padding: 24px 24px 40px; }
      }

      @media (max-width: 420px) {
        .brand__text { display: none; }
      }
    </style>
  </body>
</html>
