---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import projects from '../../data/projects.json';

const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));

const selectedSlugs = ['qwikbuild', 'desicrew', 'qaoncloud', 'origin-one'];
const selected = selectedSlugs.map((s) => bySlug[s]);
const broader = projects.filter(
  (p) => p.category === 'work' && !selectedSlugs.includes(p.slug)
);
const explorations = projects.filter((p) => p.category === 'exploration');

// Testimonials sit next to the work they describe rather than in a wall.
// Quotes, names and roles are verbatim — do not edit.
const testimonials = {
  qwikbuild: {
    quote: "Srijan has been an integral resource for the past 6 months, bringing founder energy to our GTM motion. He moves fast, understands business goals & is an excellent partner to have on your side.",
    name: "Pradeep Aiyyagiri",
    role: "Co-Founder Qwikbuild, Ex-CPO, Slice",
    avatar: "/images/avatars/pradeep.jpeg"
  },
  qaoncloud: {
    quote: "Srijan didn't just give us a brand, he gave us a story that tied our business, product & distribution in a way that would've been impossible to do otherwise.",
    name: "Sushine Ullas",
    role: "Chief Business Officer, QAonCloud",
    avatar: "/images/avatars/placeholder-1.svg"
  },
  'origin-one': {
    quote: "Srijan is highly perceptive & insightful. His deconstruction of where we stand and want to get to is tremendously educational, and he sets the cogs in motion to achieve it. Results came shockingly fast. A pleasure to work with.",
    name: "Pushkar Thakur",
    role: "Founder, Origin One & The Grafiosi",
    avatar: "/images/avatars/pushkar.jpeg"
  }
};
---

<BaseLayout
  title="Work — Explicit"
  description="Selected work from Explicit — technology companies at moments of change, and what the market needed to understand about them."
>

  <section class="work-intro reveal">
    <h1 class="work-intro__title">The work.</h1>
    <p class="work-intro__copy">
      Different companies. Different moments. Same basic question: what has become true — and how
      should the market understand it now?
    </p>
  </section>

  <!-- Selected work, with the proof that goes with it -->
  <section class="work-section reveal">
    <div class="work-stack">
      {selected.map((project) => (
        <>
          <ProjectCard project={project} featured={true} />
          {testimonials[project.slug] && (
            <figure class="pull-quote">
              <blockquote>"{testimonials[project.slug].quote}"</blockquote>
              <figcaption class="pull-quote__author">
                <span class="pull-quote__avatar">
                  <img src={testimonials[project.slug].avatar} alt={testimonials[project.slug].name} />
                </span>
                <span>
                  <span class="pull-quote__name">{testimonials[project.slug].name}</span>
                  <span class="pull-quote__role">{testimonials[project.slug].role}</span>
                </span>
              </figcaption>
            </figure>
          )}
        </>
      ))}
    </div>
  </section>

  <!-- The rest of the portfolio -->
  <section class="work-section work-section--secondary reveal">
    <h2 class="section-subheading">More work</h2>
    <div class="work-grid">
      {broader.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

    {explorations.length > 0 && (
      <>
        <h2 class="section-subheading section-subheading--spaced">Explorations</h2>
        <p class="section-intro">
          Things we made because we were curious. Ideas, experiments and self-initiated work that
          let us test what strategy and creativity can do without waiting for a brief.
        </p>
        <div class="work-grid">
          {explorations.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </>
    )}
  </section>

</BaseLayout>

<style>
  .work-intro {
    padding: 40px var(--section-padding-x) clamp(48px, 6vw, 64px);
  }

  .work-intro__title {
    font-size: var(--text-h1);
    font-weight: 500;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }

  .work-intro__copy {
    font-size: var(--text-h3);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 68ch;
  }

  .section-subheading {
    font-size: var(--text-h3);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 40px;
  }

  .section-subheading--spaced {
    margin-top: clamp(64px, 8vw, 96px);
  }

  .section-intro {
    font-size: var(--text-h3);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 70ch;
    margin-top: -20px;
    margin-bottom: 40px;
  }

  .work-section {
    padding: 0 var(--section-padding-x) clamp(56px, 7vw, 88px);
  }

  .work-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 7vw, 88px);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(32px, 4vw, 56px);
  }

  /* ===== Pull quotes ===== */
  .pull-quote {
    max-width: 68ch;
    padding-left: clamp(20px, 3vw, 32px);
    border-left: 2px solid var(--color-accent);
  }

  .pull-quote blockquote {
    font-size: var(--text-h3);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 20px;
  }

  .pull-quote__author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pull-quote__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
  }

  .pull-quote__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pull-quote__name,
  .pull-quote__role {
    display: block;
    font-size: var(--text-tiny);
    line-height: 1.4;
  }

  .pull-quote__name {
    font-weight: 500;
    color: var(--color-text);
  }

  .pull-quote__role {
    font-weight: 400;
    color: var(--color-text-tertiary);
  }

  @media (max-width: 767px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
