---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Explicit" description="Tell us what changed. Explicit works with technology companies at important moments of change." hideCta={true}>

  <section class="contact-section reveal">
    <h1 class="contact-section__headline">Tell us what changed.</h1>
    <ul class="contact-section__list">
      <li>A new product.</li>
      <li>A new market.</li>
      <li>A new audience.</li>
      <li>A new category.</li>
      <li>A company that has become something its old story can no longer explain.</li>
      <li>Or something important that people simply don't understand yet.</li>
    </ul>
    <p class="contact-section__email">
      <a href="mailto:hey@explicit.studio">hey@explicit.studio</a>
    </p>

    <form class="contact-form" action="https://formspree.io/f/xreaqbjg" method="POST">
      <div class="form-group">
        <label class="form-label" for="name">Name</label>
        <input class="form-input" type="text" id="name" name="name" required />
      </div>

      <div class="form-group">
        <label class="form-label" for="email">Email</label>
        <input class="form-input" type="email" id="email" name="email" required />
      </div>

      <div class="form-group">
        <label class="form-label" for="company">Company</label>
        <input class="form-input" type="text" id="company" name="company" />
      </div>

      <div class="form-group">
        <label class="form-label" for="url">URL</label>
        <input class="form-input" type="url" id="url" name="url" />
      </div>

      <div class="form-group">
        <label class="form-label" for="message">What do you need?</label>
        <textarea class="form-textarea" id="message" name="message" required></textarea>
      </div>

      <button type="submit" class="btn-primary form-submit">
        Send message <span class="arrow">&rarr;</span>
      </button>
    </form>

  </section>

</BaseLayout>

<style>
  .contact-section {
    padding: 40px var(--section-padding-x) var(--section-padding-y);
  }

  .contact-section__headline {
    font-size: var(--text-h1);
    font-weight: 500;
    margin-bottom: 16px;
  }

  .contact-section__list {
    max-width: 60ch;
    margin-bottom: 32px;
  }

  .contact-section__list li {
    font-size: var(--text-h3);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .contact-section__email {
    font-size: var(--text-h3);
    font-weight: 500;
    margin-bottom: 48px;
  }

  .contact-section__email a {
    color: var(--color-accent);
    transition: color 0.3s ease;
  }

  .contact-section__email a:hover {
    color: var(--color-accent-hover);
  }

  .contact-form {
    max-width: 600px;
  }

  .form-group {
    margin-bottom: 24px;
  }

  .form-label {
    display: block;
    font-size: var(--text-small);
    font-weight: var(--weight-book);
    color: var(--color-text-tertiary);
    margin-bottom: 8px;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    border: none;
    border-bottom: 1px solid var(--color-border);
    padding: 12px 0;
    font-size: var(--text-h3);
    font-weight: 400;
    line-height: 1.6;
    font-family: var(--font-primary);
    background: transparent;
    color: var(--color-text);
    outline: none;
    transition: border-color 0.3s ease;
    border-radius: 0;
    -webkit-appearance: none;
  }

  .form-input:-webkit-autofill,
  .form-input:-webkit-autofill:hover,
  .form-input:-webkit-autofill:focus,
  .form-textarea:-webkit-autofill,
  .form-textarea:-webkit-autofill:hover,
  .form-textarea:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--color-text);
    -webkit-box-shadow: 0 0 0px 1000px var(--color-bg) inset;
    transition: background-color 5000s ease-in-out 0s;
    font-family: var(--font-primary);
  }

  .form-input:focus,
  .form-textarea:focus {
    border-bottom-color: var(--color-text);
  }

  .form-textarea {
    min-height: 120px;
    resize: vertical;
  }

  .form-submit {
    margin-top: 32px;
  }

</style>
