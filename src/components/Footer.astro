---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__top">
    <div class="footer__brand">
      <img src="/images/logos/logo.png" alt="Explicit" class="footer__logo-img" />
      <p class="footer__descriptor">Strategic creative partners for technology companies.</p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/work">Work</a>
      <a href="/info">About</a>
      <a href="/contact">Contact</a>
    </nav>

    <div class="footer__contact">
      <a href="mailto:hey@explicit.studio" class="footer__email">hey@explicit.studio</a>
      <div class="footer__socials">
        <a href="https://x.com/studio_explicit" target="_blank" rel="noopener noreferrer">Twitter (AKA X)</a>
        <a href="#" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <span>&copy; {year} Explicit&reg;</span>
    <span class="footer__bottom-note">Explicit works with technology companies at important moments of change.</span>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(48px, 6vw, 72px) var(--section-padding-x) clamp(32px, 4vw, 40px);
    border-top: 1px solid var(--color-rule);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .footer__logo-img {
    width: 140px;
    height: auto;
    margin-bottom: 16px;
  }

  .footer__descriptor {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text-secondary);
    max-width: 24ch;
    line-height: 1.5;
  }

  .footer__nav,
  .footer__socials {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer__nav a,
  .footer__socials a,
  .footer__email {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color 0.3s ease;
  }

  .footer__nav a:hover,
  .footer__socials a:hover,
  .footer__email:hover {
    color: var(--color-accent);
  }

  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer__email {
    color: var(--color-text);
  }

  .footer__socials {
    margin-top: 6px;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--color-rule);
    font-size: var(--text-tiny);
    font-weight: 400;
    color: var(--color-text-tertiary);
  }

  .footer__bottom-note {
    text-align: right;
  }

  @media (max-width: 767px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer__bottom {
      flex-direction: column;
      gap: 10px;
    }

    .footer__bottom-note {
      text-align: left;
    }
  }
</style>
